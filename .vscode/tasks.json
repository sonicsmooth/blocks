{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Nim Project",
            "type": "shell",
            "command": "nim c -d:debug --debugger:native blocks.nim",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Nim: Check File",
            "type": "shell",
            "command": "nim",
            "args": [
                "check",
                "${file}"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "nim",
                "fileLocation": [
                    "absolute"
                ],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),\\s*(\\d+)\\)\\s+(Error|Warning|Hint):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}

